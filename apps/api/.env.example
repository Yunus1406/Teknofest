# Yerel geliştirme: varsayılan SQLite dosyası kullanılır, aşağıdaki satırı açmadan da çalışır.
# Docker Compose / üretim: Postgres bağlantısı için açın.
# DATABASE_URL=postgresql+psycopg2://recete:recete@localhost:5432/recete_os

ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# LLM çağrılarını devre dışı bırakıp deterministik fallback metin kullanmak için (test/CI ortamı):
LLM_DISABLED=false

# Faz C.1 — Dijital Ürün Pasaportu QR kodunun hedeflediği genel web sayfası kökü.
PUBLIC_WEB_BASE_URL=http://localhost:3000
# Yetkili Alan (ticari hammadde grade/lot/tedarikçi detayları) erişim anahtarı.
# Gerçek bir kullanıcı/oturum sistemi DEĞİL — MVP: tek paylaşılan sabit anahtar.
# Boş bırakılırsa (varsayılan) authorized alan HİÇBİR istekte açılmaz.
# DPP_AUTHORIZED_KEY=degistirin-bu-bir-ornektir
